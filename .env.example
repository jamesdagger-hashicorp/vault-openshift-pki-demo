# .env.example
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it is listed in .gitignore.
#
# Usage:
#   cp .env.example .env
#   # edit .env with your values
#   source .env
#
# All variables have sensible defaults in the scripts. Only the variables
# marked REQUIRED must be set before running the corresponding script.

# =============================================================================
# OpenShift / Cluster
# =============================================================================

# REQUIRED — OpenShift API server URL (from the OpenShift web console: ? > Copy Login Command)
OC_SERVER=https://api.your-cluster.example.com:6443

# REQUIRED — OpenShift login token (from: oc login --token=... or Copy Login Command)
# Obtain a fresh token from the OpenShift web console each session.
OC_TOKEN=sha256~replace-with-your-token

# Kubernetes namespace where Vault will be deployed.
# On the Developer Sandbox your project is pre-assigned — set this to match it
# (e.g. jamesdagger-dev). On a full OCP cluster the bootstrap script will
# create the namespace if it does not exist.
NAMESPACE=vault

# =============================================================================
# Vault Enterprise Licence
# =============================================================================

# REQUIRED — Your Vault Enterprise licence key.
# Used by scripts/bootstrap.sh to create the vault-license OpenShift Secret.
# The key is injected into Vault at runtime via a mounted Secret volume.
VAULT_LICENSE=02MV4AA...your-licence-key-here...

# =============================================================================
# Vault API access
# =============================================================================

# REQUIRED (after bootstrap) — The address scripts use to reach the Vault API.
# Use the OpenShift Route if one is configured, or port-forward locally:
#   oc port-forward -n vault svc/vault 8200:8200
VAULT_ADDR=http://localhost:8200

# REQUIRED (after init) — Vault token used by configuration scripts.
# Populated automatically from private/vault-init.json by init-unseal.sh.
# After initial setup, replace with a narrower-scoped token.
# Example: export VAULT_TOKEN=$(jq -r '.root_token' private/vault-init.json)
VAULT_TOKEN=

# Suppress Vault CLI TLS verification warnings when TLS is disabled (demo only).
# Set to false if TLS is enabled on the Vault listener.
VAULT_SKIP_VERIFY=true

# =============================================================================
# Helm
# =============================================================================

# Helm release name. Default: vault
RELEASE_NAME=vault

# Path to the Helm values file. Default: helm/vault-values.yaml
HELM_VALUES=helm/vault-values.yaml

# =============================================================================
# PKI configuration (optional overrides)
# =============================================================================

# Common name for the root CA certificate. Default: Demo Root CA
ROOT_CA_CN=Demo Root CA

# Common name for the intermediate CA certificate. Default: Demo Intermediate CA
INT_CA_CN=Demo Intermediate CA

# Domain(s) the PKI role will be permitted to issue certificates for.
# Default: demo.example.com
ALLOWED_DOMAINS=demo.example.com

# Maximum TTL for issued certificates. Default: 72h
MAX_TTL=72h

# =============================================================================
# Storage (advanced)
# =============================================================================

# Directory where generated CA certificates and test certs are written.
# Default: private (gitignored)
OUTPUT_DIR=private
